rules_version = '2';

// Vernox Firestore security rules.
//
// Trust model:
//  - The serverless API (api/) uses the Firebase Admin SDK, which bypasses these
//    rules. It is the only writer of orders, stock reservations, coupons usage,
//    idempotency keys, webhook events, rate limits, audit logs and staff roles.
//  - Design consultations (consultations/*) are likewise written only by the API.
//  - Staff roles are the `role` custom claim, set only via the Admin SDK.
//    The role -> permission mapping below MIRRORS STAFF_ROLE_PERMISSIONS in
//    src/types/admin.ts; change both together (and src/test/firestore.rules.test.ts).
//  - Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- identity helpers ----------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Password accounts must verify their email before a staff role counts.
    function emailTrusted() {
      return request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'password'
        || request.auth.token.get('email_verified', false) == true;
    }

    function role() {
      return signedIn() && emailTrusted() ? request.auth.token.get('role', '') : '';
    }

    function hasRole(roles) {
      return role() in roles;
    }

    // ---------- permission helpers (mirror src/types/admin.ts) ----------

    function canWriteCatalog()    { return hasRole(['super_admin', 'admin', 'catalog_manager']); }
    function canWriteSettings()   { return hasRole(['super_admin', 'admin']); }
    function canReadOrders()      { return hasRole(['super_admin', 'admin', 'order_manager', 'production', 'shipping', 'finance', 'support']); }
    function canUpdateOrders()    { return hasRole(['super_admin', 'admin', 'order_manager', 'production', 'shipping']); }
    function canReadCoupons()     { return hasRole(['super_admin', 'admin', 'finance', 'support']); }
    function canWriteCoupons()    { return hasRole(['super_admin', 'admin']); }
    function canModerateReviews() { return hasRole(['super_admin', 'admin', 'catalog_manager', 'support']); }
    function canReadCustomers()   { return hasRole(['super_admin', 'admin', 'order_manager', 'support']); }
    function canReadB2b()         { return hasRole(['super_admin', 'admin', 'order_manager', 'support']); }
    function canReadTickets()     { return hasRole(['super_admin', 'admin', 'order_manager', 'support']); }
    function canReadConsultations() { return hasRole(['super_admin', 'admin', 'designer']); }
    function canReadStaff()       { return hasRole(['super_admin', 'admin']); }
    function canReadAudit()       { return hasRole(['super_admin']); }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- public catalog ----------

    match /products/{productId} {
      allow read: if true;
      allow write: if canWriteCatalog();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if canWriteCatalog();
    }

    match /topics/{topicId} {
      allow read: if true;
      allow write: if canWriteCatalog();
    }

    match /config/{configDoc} {
      allow read: if true;
      allow write: if canWriteSettings();
    }

    // settings/store holds tax, shipping, COD, seller (GSTIN) and contact details
    // read by the API and storefront. It is public: never store secrets here
    // (provider keys and webhook tokens are server environment variables).
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if canWriteSettings();
    }

    // ---------- customers ----------

    match /users/{uid} {
      allow read: if isOwner(uid) || canReadCustomers();
      allow create: if isOwner(uid)
        && !request.resource.data.keys().hasAny(['role', 'isAdmin']);
      allow update: if isOwner(uid)
        && !changedKeys().hasAny(['role', 'isAdmin']);
      allow delete: if false;

      // My Space: private to the customer (staff, designers included, never read it; a paid
      // consultation carries its own snapshot, see /consultations below). The server re-validates the
      // walls when it snapshots them, so these rules only bound size and shape.
      match /spaces/{spaceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSpace(request.resource.data);
      }
    }

    match /wishlists/{uid} {
      allow read, write: if isOwner(uid);
    }

    function validSpace(d) {
      return d.keys().hasOnly(['id', 'name', 'roomType', 'budgetBand', 'notes', 'walls', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 80
        && d.roomType in ['living', 'bedroom', 'pooja', 'entrance', 'office', 'outdoor', 'kids']
        && (d.get('budgetBand', null) == null || d.budgetBand in ['under_10k', '10k_25k', '25k_50k', 'over_50k'])
        && d.get('notes', '') is string && d.get('notes', '').size() <= 2000
        && d.walls is list && d.walls.size() <= 8;
    }

    // ---------- design consultations (created and changed only by the API) ----------

    // The id equals the paid order's id. Customers read their own; designers and admins read all.
    // Wall photos and previews are snapshotted under consultations/{id}/ in Storage (storage.rules),
    // so a designer never needs access to a customer's private space.
    match /consultations/{consultationId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || canReadConsultations();
      allow write: if false;

      // Proposal draft: staff only, invisible to the customer until it is sent.
      match /private/{docId} {
        allow read: if canReadConsultations();
        allow write: if false;
      }
    }

    // ---------- reviews ----------

    match /reviews/{reviewId} {
      // No public read: a review document holds the author's uid, order id and private upload paths.
      // Shoppers get published reviews, reduced to public fields, from GET /api/catalog.
      allow read: if canModerateReviews()
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Submissions go through POST /api/engage (SUBMIT_REVIEW), which verifies a delivered purchase.
      allow create: if false;
      allow update, delete: if canModerateReviews();
    }

    // ---------- orders (created and paid only by the API) ----------

    // Workshop moves staff may write directly. MIRRORS STAFF_WORKSHOP_MOVES in
    // src/types/orderStatus.ts (ORDER_TRANSITIONS restricted to STAFF_SETTABLE_STATUSES);
    // src/test/orderLifecycle.test.ts parses this map and fails if they differ.
    // Legacy Phase 1 statuses (Designing, Finished) move like In_Design / Finishing.
    // Shipping, delivery, cancellation, returns and refunds are API-only (invoice,
    // stock, refunds, notifications). Prefer UPDATE_ORDER_STATUS, which also notifies.
    function staffWorkshopMoves() {
      return {
        'Paid': ['In_Design'],
        'Confirmed_COD': ['In_Design'],
        'In_Design': ['Cutting'],
        'Cutting': ['Finishing', 'In_Design'],
        'Finishing': ['Quality_Check', 'Cutting'],
        'Quality_Check': ['Packed', 'Finishing', 'Cutting'],
        'Packed': ['Quality_Check'],
        'Partially_Refunded': ['In_Design', 'Cutting', 'Finishing', 'Quality_Check', 'Packed'],
        'Designing': ['Cutting'],
        'Finished': ['Quality_Check', 'Cutting']
      };
    }

    match /orders/{orderId} {
      allow read: if (signedIn() && resource.data.userId == request.auth.uid) || canReadOrders();
      allow create, delete: if false;
      // Staff may move workshop stages and annotate; money, items, customer,
      // payment, shipment and invoice fields are immutable from clients.
      allow update: if canUpdateOrders()
        && changedKeys().hasOnly(['status', 'statusHistory', 'assignedTo', 'tracking', 'notes', 'updatedAt'])
        && (
          request.resource.data.status == resource.data.status
          || (request.resource.data.status in staffWorkshopMoves().get(resource.data.status, [])
              // A held order (hold set by the API) keeps its stage until the hold is released.
              && resource.data.get('hold', null) == null)
        )
        // QC / packing records are stored in `notes` by the staff consoles.
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 20000;
    }

    // ---------- B2B inquiries ----------

    match /b2b_inquiries/{inquiryId} {
      // Created only by the API (POST /api/engage TRADE_ENQUIRY), which validates and rate-limits it.
      allow create: if false;
      allow read, update, delete: if canReadB2b();
    }

    // ---------- support tickets (contact form; created and changed only by the API) ----------

    match /tickets/{ticketId} {
      allow read: if canReadTickets();
      allow write: if false;
    }

    // ---------- newsletter (server-only: holds subscriber emails and unsubscribe tokens) ----------

    match /newsletter_subscribers/{emailHash} {
      allow read, write: if false;
    }

    // ---------- coupons (staff only; evaluation happens in the API) ----------

    match /coupons/{couponId} {
      allow read: if canReadCoupons();
      allow write: if canWriteCoupons()
        && (!('usedCount' in request.resource.data)
            || (resource != null && request.resource.data.usedCount == resource.data.get('usedCount', 0))
            || (resource == null && request.resource.data.usedCount == 0));

      match /customer_usage/{customerKey} {
        allow read, write: if false;
      }
    }

    // ---------- staff & audit ----------

    match /staff/{uid} {
      allow read: if isOwner(uid) || canReadStaff();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if canReadAudit();
      allow write: if false;
    }

    // ---------- server-only collections ----------

    match /coupon_usages/{usageId} {
      allow read, write: if false;
    }
    match /idempotency/{key} {
      allow read, write: if false;
    }
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }
    match /rate_limits/{key} {
      allow read, write: if false;
    }
    // Phase 2 (India commerce). Customers reach their invoices, cancellations and
    // returns only through the API (/api/invoice, /api/order-cancel, /api/return-request).
    match /invoices/{invoiceId} {
      allow read, write: if false;
    }
    match /credit_notes/{creditNoteId} {
      allow read, write: if false;
    }
    match /counters/{counterId} {
      allow read, write: if false;
    }
    match /refunds/{refundId} {
      allow read, write: if false;
    }
    match /returns/{orderId} {
      allow read, write: if false;
    }
    match /notifications_outbox/{notificationId} {
      allow read, write: if false;
    }
    match /courier_events/{eventId} {
      allow read, write: if false;
    }
    match /serviceability_cache/{pincode} {
      allow read, write: if false;
    }
    // Shiprocket API token cache.
    match /integrations/{integrationId} {
      allow read, write: if false;
    }
    // Legacy collection from the removed shared-password admin login.
    match /admin_users/{adminId} {
      allow read, write: if false;
    }
  }
}
