# Development Dockerfile for Vernox Frontend with Live HMR
FROM node:20-alpine

WORKDIR /app

# Cache dependencies
COPY package.json package-lock.json ./
RUN npm ci

# Copy source files
COPY . .

# Expose Vite dev server port
EXPOSE 8080

ENV NODE_ENV=development
ENV CHOKIDAR_USEPOLLING=true

# Launch Vite dev server bound to 0.0.0.0 and port 8080
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8080"]
