{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/release-reservations",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/send-notifications",
      "schedule": "*/2 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/product/:slug",
      "destination": "/api/seo?kind=product&slug=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?kind=sitemap"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
