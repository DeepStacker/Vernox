# Vernox environment variables. Copy to .env.local (never commit real values).
# Server variables are read by the API (api/, server/index.ts, scripts/); VITE_* are bundled into the browser.

# ---------- Firebase Admin (server, REQUIRED: one of the two credential options) ----------
# Base64 of the service-account JSON (recommended on Vercel):  base64 -i service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or a path to the service-account JSON file (Docker / local).
GOOGLE_APPLICATION_CREDENTIALS=
# Project id; required with the emulators, otherwise taken from the service account.
FIREBASE_PROJECT_ID=vernox-1b5d5
# Local emulators (optional). When set, the Admin SDK talks to them and needs no credentials.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---------- Razorpay (server, REQUIRED) ----------
# Use test keys (rzp_test_...) for local development and previews; there is no mock payment mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Secret configured on the webhook in the Razorpay dashboard (distinct from the key secret).
# Subscribe to: payment.captured, order.paid, payment.failed, refund.processed.
RAZORPAY_WEBHOOK_SECRET=

# ---------- Cron (server, REQUIRED on Vercel) ----------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/release-reservations
# and /api/cron/send-notifications.
CRON_SECRET=

# ---------- Store defaults (server, optional) ----------
# Used only for fields missing from the Firestore document settings/store (which staff edit;
# seller GSTIN/address and contact details live only there). Rupee amounts.
STORE_GST_RATE_PERCENT=18
STORE_SHIPPING_FEE_INR=150
STORE_FREE_SHIPPING_THRESHOLD_INR=5000
# Cash on delivery: catalogue items only; carts with a custom studio piece are prepaid only.
STORE_COD_ENABLED=true
STORE_COD_FEE_INR=49
# COD is refused when the order total (incl. GST) is above this.
STORE_COD_MAX_ORDER_VALUE_INR=10000
# Undelivered COD orders allowed per mobile number.
STORE_COD_MAX_OPEN_ORDERS_PER_PHONE=2
# Production days before dispatch (catalogue default / custom studio pieces), courier transit
# estimate without Shiprocket, and the return window after delivery.
STORE_DEFAULT_LEAD_TIME_DAYS=3
STORE_CUSTOM_LEAD_TIME_DAYS=7
STORE_MANUAL_TRANSIT_DAYS=5
STORE_RETURN_WINDOW_DAYS=7
# HSN for products without hsnCode. 8306 = statuettes/ornaments of base metal; 7326 = other
# articles of iron or steel. OWNER MUST CONFIRM the classification with their CA.
STORE_DEFAULT_HSN_CODE=8306

# ---------- Shiprocket courier (server, optional) ----------
# All three of email/password/pickup location set → Shiprocket books AWBs, pickups, labels and
# manifests. Otherwise the manual provider is used (staff enter courier + AWB).
# Use a dedicated Shiprocket API user (Settings → API → Configure), not the owner login.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Pickup location nickname exactly as in Shiprocket (Settings → Pickup addresses).
SHIPROCKET_PICKUP_LOCATION=
# Pickup PIN for serviceability checks; defaults to settings/store.seller.pincode.
SHIPROCKET_PICKUP_PINCODE=
# Token Shiprocket sends as x-api-key to /api/courier-webhook (Settings → API → Webhooks).
SHIPROCKET_WEBHOOK_TOKEN=

# ---------- Notifications (server, optional; unconfigured channels are skipped) ----------
# Email via Resend (verify the sending domain in Resend first).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="Vernox <orders@vernox.in>"
# SMS via MSG91 Flow. Templates must be DLT-registered; JSON map of event → MSG91 template id.
# Events: order_confirmed, in_production, shipped, out_for_delivery, delivered, cancelled,
# refund_processed, return_requested, return_approved, return_rejected, return_received.
# Variables: var1 first name, var2 order number, var3 event value (amount / AWB / status).
MSG91_AUTH_KEY=
MSG91_TEMPLATES={}

# ---------- Node adapter (server/index.ts, optional) ----------
PORT=3001
NODE_ENV=development

# ---------- Browser ----------
# The checkout no longer needs this (checkout-intent returns keyId); kept for legacy UI code.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_EMULATOR_HOST=localhost

# Canonical public origin, no trailing slash. Used for canonical/OG URLs, sitemap.xml and (server)
# the links in customer notifications — set it on the server environment too.
# Defaults to https://vernox.in when unset.
VITE_SITE_URL=https://vernox.in
